      { "id": "t", "type": "text", "text": "Esta versión ya no funciona con el probador. Actualiza para seguir.", "style": "secondary", "align": "center" },
      { "id": "b", "type": "button", "title": "Ir al App Store", "style": "primary", "action": { "type": "openURL", "url": "https://apps.apple.com/app/id0000000000", "inApp": false, "thenDismiss": true } }
