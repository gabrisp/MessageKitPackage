    "en": [
      { "id": "ic", "type": "icon", "symbol": "arrow.down.app.fill", "tint": "accent", "size": 44 },
      { "id": "h", "type": "heading", "text": "Update ReWearly", "size": "medium", "align": "center" },
      { "id": "t", "type": "text", "text": "This version no longer works with the fitting room. Update to continue.", "style": "secondary", "align": "center" },
